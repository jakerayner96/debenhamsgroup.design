{
  "name": "designsystem-debenhamsgroup",
  "version": "0.0.1",
  "private": true,
  "description": "Debenhams Group Design System — monorepo",
  "scripts": {
    "dev": "pnpm --filter @designsystem-debenhamsgroup/docs dev",
    "build": "pnpm -r build",
    "build:tokens": "pnpm --filter @designsystem-debenhamsgroup/tokens build",
    "build:react": "pnpm --filter @designsystem-debenhamsgroup/react build",
    "build:docs": "pnpm --filter @designsystem-debenhamsgroup/docs build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.4.0"
}
